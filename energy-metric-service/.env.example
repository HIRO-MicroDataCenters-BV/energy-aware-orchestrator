# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orchestration_db

# Kubernetes Configuration
USE_KUBECTL_PROXY=true
KUBERNETES_SERVICE_HOST=localhost
KUBERNETES_SERVICE_PORT=8080

# Feature Flags
ENABLE_METRICS_SCHEDULER=false
ENABLE_DEPLOYMENT_SCHEDULER=true

# Optional: Node Mappings (format: ip1:name1,ip2:name2)
# NODE_MAPPINGS=192.168.49.2:minikube

# Optional: Kubernetes Token (if not using kubectl proxy)
# K8S_TOKEN=your-service-account-token

# Grid Capacity Polling (optional)
# Off unless ENABLE_GRID_POLLING=true AND at least one source below is set.
# ENABLE_GRID_POLLING=true
# GRID_POLL_INTERVAL_SECONDS=300
#
# HTTP source (e.g. a real grid API, or the dev/test grid-stub)
# GRID_API_URL=http://localhost:8090/capacity
#
# Modbus source (one or more PDUs). GRID_MODBUS_HOST is the Main PDU's
# (or a standalone PDU's) address - link PDUs in a cluster don't serve
# Modbus themselves. Start with a single unit id; multiple ids (cluster
# mode) is best-effort and not yet vendor-verified.
# GRID_MODBUS_HOST=192.168.1.50
# GRID_MODBUS_PORT=502
# GRID_MODBUS_UNIT_IDS=1
# GRID_MODBUS_MODE=reading
# GRID_MODBUS_RATED_CAPACITY_WATTS=
