# Environment variables for local development

# Python path (adjust to your project path)
export PYTHONPATH=<path>/energy-aware-operator

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
export LOG_LEVEL=DEBUG

# How often to re-evaluate schedules in seconds (default: 600 = 10 minutes)
export KOPF_RECONCILE_INTERVAL_SECONDS=300

# Energy API endpoint (update with your service URL)
export ENERGY_API_URL=http://localhost:8000

# Usage:
# 1. Copy this file: cp env.local.example .env
# 2. Edit .env with your values
# 3. Source it: source .env
# 4. Run operator: uv run kopf run app/operator.py --verbose


